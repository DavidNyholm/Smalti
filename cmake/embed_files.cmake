# Turns files into C++ byte arrays at configure time, so the library carries its fonts and its
# built-in themes and needs no files next to the program. The output is rewritten only when its
# content changes, and CMake re-runs this when an input file changes.
#
#   smalti_embed_files(<output.cpp> <array name> <file> [<array name> <file> ...])
#
# Each file becomes `const unsigned char <name>[]` and `const size_t <name>Size` in
# smalti::detail.

function(smalti_embed_files output)
  set(pairs ${ARGN})
  list(LENGTH pairs count)
  math(EXPR odd "${count} % 2")
  if(count EQUAL 0 OR odd)
    message(FATAL_ERROR "smalti_embed_files: give an array name and a file for each file")
  endif()
  set(content "// Generated by cmake/embed_files.cmake. Do not edit.\n#include <cstddef>\n\nnamespace smalti::detail {\n\n")
  while(pairs)
    list(POP_FRONT pairs name file)
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "smalti: ${file} is missing; it is part of the source tree")
    endif()
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Line breaks keep the generated file readable by editors and diff tools.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
    string(APPEND content "extern const unsigned char ${name}[] = {\n${bytes}};\n")
    string(APPEND content "extern const size_t ${name}Size = ${size};\n\n")
    set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
  endwhile()
  string(APPEND content "}  // namespace smalti::detail\n")
  if(EXISTS "${output}")
    file(READ "${output}" existing)
  endif()
  if(NOT existing STREQUAL content)
    file(WRITE "${output}" "${content}")
  endif()
endfunction()
