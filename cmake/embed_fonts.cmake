# Turns fonts/Inter-*.ttf into C++ byte arrays at configure time, so the library carries its
# default font and needs no files next to the program. The output is rewritten only when its
# content changes, and CMake re-runs this when a font file changes.

function(smalti_embed_fonts output)
  set(content "// Generated by cmake/embed_fonts.cmake from fonts/*.ttf. Do not edit.\n#include <cstddef>\n\nnamespace smalti::detail {\n\n")
  foreach(weight Regular Medium SemiBold)
    set(font "${PROJECT_SOURCE_DIR}/fonts/Inter-${weight}.ttf")
    if(NOT EXISTS "${font}")
      message(FATAL_ERROR "smalti: ${font} is missing; the fonts folder is part of the source tree")
    endif()
    file(READ "${font}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Line breaks keep the generated file readable by editors and diff tools.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
    string(APPEND content "extern const unsigned char kInter${weight}[] = {\n${bytes}};\n")
    string(APPEND content "extern const size_t kInter${weight}Size = ${size};\n\n")
    set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${font}")
  endforeach()
  string(APPEND content "}  // namespace smalti::detail\n")
  if(EXISTS "${output}")
    file(READ "${output}" existing)
  endif()
  if(NOT existing STREQUAL content)
    file(WRITE "${output}" "${content}")
  endif()
endfunction()
